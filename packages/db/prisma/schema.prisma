model Project {
  id                                       String               @id @default(uuid())
  name                                     String
  description                              String?
  status                                   String               @default("not_started")
  priority                                 String               @default("medium")
  deadline                                 DateTime?
  startDate                                DateTime             @default(now())
  progress                                 Int                  @default(0)
  budget                                   Float                @default(0)
  projectType                              String               @default("internal")
  visibility                               String               @default("public")
  billingType                              String               @default("non_billable")
  ownerId                                  String?
  memberIds                                String[]
  clientIds                                String[]
  tags                                     String[]
  companyId                                String?
  createdAt                                DateTime             @default(now())
  updatedAt                                DateTime             @updatedAt
  deletedAt                                DateTime?
  customTaskStatusName                     String?              @default("Custom")
  socialServices                           String[]             @default(["content_calendar", "publishing", "analytics"])
  socialSettings                           Json?                @default("{\"defaultTimezone\":\"UTC\",\"approvalRequired\":true,\"storageRetentionDays\":30}")
  contentCalendars_ProjectContentCalendars ContentCalendar[]    @relation("ProjectContentCalendars")
  expenseTransactions                      ExpenseTransaction[]
  goals                                    Goal[]               @relation("GoalProject")
  invoices                                 Invoice[]
  milestones                               Milestone[]          @relation("ProjectMilestones")
  modules_ProjectModules                   Module[]             @relation("ProjectModules")
  company                                  Company?             @relation(fields: [companyId], references: [id])
  tasks                                    Task[]
  documents                                Document[]           @relation("ProjectDocuments")
  timeLogs_ProjectTimeLogs                 TimeLog[]            @relation("ProjectTimeLogs")
  workLogs_ProjectWorkLogs                 WorkLog[]            @relation("ProjectWorkLogs")
  socialAccounts                          SocialAccount[]       @relation("ProjectSocialAccounts")
  brandVoiceProfile                       BrandVoiceProfile?    @relation("ProjectBrandVoiceProfile")
  socialPosts                             SocialPost[]          @relation("ProjectSocialPosts")
  clientReviewSessions                    ClientReviewSession[] @relation("ProjectClientReviewSessions")
  socialConversations                     SocialConversation[]  @relation("ProjectSocialConversations")
  evergreenQueueSlots                     EvergreenQueueSlot[]  @relation("ProjectEvergreenQueueSlots")
  socialEngagementRules                   SocialEngagementRule[] @relation("ProjectSocialEngagementRules")
  managerConversations                    ManagerConversation[]  @relation("ProjectManagerConversations")
  postVideoIntelligences                  PostVideoIntelligence[] @relation("ProjectPostVideoIntelligences")

  @@index([companyId, status])
  @@index([companyId])
  @@index([companyId, id])
  @@index([companyId, createdAt])
}

model Task {
  id                    String    @id @default(uuid())
  title                 String
  description           String?
  status                String    @default("todo")
  priority              String    @default("medium")
  dueDate               DateTime?
  estimatedHours        Float     @default(0)
  isOverdueNotified     Boolean   @default(false)
  completedOnTime       Boolean?
  projectId             String?
  assigneeId            String?
  creatorId             String?
  companyId             String?
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  attachments           String[]  @default([])
  voiceMessageUrl       String?
  moduleId              String?
  clientId              String?
  contentPieceId        String?
  socialPostId          String?
  deliverableUrl        String?
  editingInstructions   String?   @db.Text
  sourceMediaUrls       String[]  @default([])
  assignee              User?     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  company               Company?  @relation(fields: [companyId], references: [id])
  creator               User?     @relation("TaskCreator", fields: [creatorId], references: [id])
  module                Module?   @relation(fields: [moduleId], references: [id])
  project               Project?  @relation(fields: [projectId], references: [id])
  client                Client?   @relation(fields: [clientId], references: [id])
  timeLogs_TaskTimeLogs TimeLog[] @relation("TaskTimeLogs")
  workLogs_TaskWorkLogs WorkLog[] @relation("TaskWorkLogs")

  @@index([projectId, status])
  @@index([assigneeId, status])
  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([companyId])
  @@index([companyId, id])
  @@index([contentPieceId])
  @@index([socialPostId])
}

model Invoice {
  id               String            @id @default(uuid())
  invoiceNumber    String
  companyId        String
  projectId        String?
  clientId         String?
  clientName       String?
