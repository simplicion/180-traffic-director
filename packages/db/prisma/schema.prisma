generator client {
  provider        = "prisma-client-js"
  engineType      = "library"
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 180 TRAFFIC DIRECTOR SCHEMA
// ==========================================

model Company {
  id                   String                       @id @default(uuid())
  name                 String
  slug                 String?                      @unique
  logoUrl              String?
  bannerUrl            String?
  oneLineDescription   String?
  industry             String?
  startupStage         String?
  teamSize             String?
  country              String?
  website              String?
  customDomain         String?                      @unique
  foundedDate          DateTime?
  companyType          String?
  tagline              String?
  headquarters         String?
  otherOffices         String?
  aboutUs              String?
  vision               String?
  mission              String?
  story                String?
  coreValues           Json?                        @default("[]")
  socialLinks          Json?                        @default("{}")
  productsBuilt        String?
  happyClients         String?
  countriesActive      String?
  awardsCount          String?
  topRecognition       String?
  companyHighlights    Json?                        @default("[]")
  profileViews         Int                          @default(0)
  followersCount       Int                          @default(0)
  privacySettings      Json?                        @default("{}")
  adminName            String?
  adminEmail           String?                      @unique
  adminPhone           String?
  adminPasswordHash    String?
  adminRole            String                       @default("admin")
  databaseConfigured   Boolean                      @default(false)
  isOnboardingComplete Boolean                      @default(false)
  subscriptionStatus   String                       @default("trial")
  accountStatus        String                       @default("active")
  totalUsers           Int                          @default(0)
  currency             String?                      @default("USD")
  currencySymbol       String?                      @default("$")
  metadata             Json?                        @default("{}")
  trialStartDate       DateTime?
  trialEndDate         DateTime?
  nextChargeDate       DateTime?
  autopayEnabled       Boolean                      @default(false)
  mandateStatus        String?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  users                                          User[]
  trafficLinks                                   TrafficLink[]
  trafficDirectorSubscription                    TrafficDirectorSubscription?
  trafficRules_CompanyTrafficRules               TrafficRule[]                 @relation("CompanyTrafficRules")
  trafficLogs_CompanyTrafficLogs                 TrafficLog[]                  @relation("CompanyTrafficLogs")
  trafficPixelConfigs_CompanyTrafficPixelConfigs TrafficPixelConfig[]          @relation("CompanyTrafficPixelConfigs")
  trafficPixelLogs_CompanyTrafficPixelLogs       TrafficPixelLog[]             @relation("CompanyTrafficPixelLogs")
}

model User {
  id               String    @id @default(uuid())
  name             String
  email            String    @unique
  emailVerified    DateTime?
  googleId         String?   @unique
  password         String?
  passwordHash     String?
  avatarUrl        String?   @default("")
  age              Int?
  isOnboarded      Boolean   @default(false)
  isVerified       Boolean   @default(false)
  isEmailVerified  Boolean   @default(false)
  isPhoneVerified  Boolean   @default(false)
  otpExpiresAt     DateTime?
  role             String    @default("employee")
  designationId    String?
  permissions      String[]  @default([])
  image            String?
  photoUrl         String?
  bannerImage      String?
  phone            String?
  isActive         Boolean   @default(true)
  canViewActivity  Boolean   @default(false)
  otpCode          String?
  otpExpiry        DateTime?
  username         String?   @unique
  headline         String?
  title            String?
  signatureImage   String?
  companyName      String?
  bio              String?
  city             String?
  country          String?
  address          String?
  latitude         Float?
  longitude        Float?
  socialLinks      Json?
  highlights       Json?     @default("[]")
  interests        String[]  @default([])
  employeeId       String?
  department       String?
  position         String?
  joinDate         DateTime?
  performanceScore Int       @default(100)
  salary           Float     @default(0)
  leaveBalance     Float     @default(20)
  emergencyContact String?
  bankAccount      String?
  employmentType   String?
  workLocation     String?
  managerId        String?
  mfaEnabled       Boolean   @default(false)
  mfaSecret        String?
  isFirstLogin     Boolean   @default(true)
  apiKey           String?
  apiKeyEnabled    Boolean   @default(false)
  companyId        String?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company          Company?  @relation(fields: [companyId], references: [id])

  @@unique([companyId, employeeId])
  @@index([companyId])
  @@index([companyId, id])
  @@index([companyId, createdAt])
}

model DomainRegistry {
  id               String    @id @default(uuid())
  domain           String    @unique
  type             String    // 'ADVERTISING_WEBSITE' | 'TRAFFIC_LINK' | 'COMPANY_PROFILE'
  targetId         String    // websiteId, linkId, or companyId
  companyId        String?
  status           String    @default("PENDING_VERIFICATION") // 'PENDING_VERIFICATION' | 'ACTIVE' | 'FAILED' | 'REMOVED'
  sslStatus        String    @default("PENDING")              // 'PENDING' | 'ACTIVE' | 'FAILED'
  isApex           Boolean   @default(false)
  verificationData Json?     @default("{}")
  verifiedAt       DateTime?
  lastCheckedAt    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([domain])
  @@index([companyId])
  @@index([type, targetId])
}

model TrafficLink {
  id                  String             @id @default(uuid())
  companyId           String
  name                String
  slug                String             @unique
  description         String?
  fallbackUrl         String
  isActive            Boolean            @default(true)
  customDomain        String?
  tags                String[]           @default([])
  totalClicks         Int                @default(0)
  warmupUntil         DateTime?
  rampUpEnabled       Boolean            @default(false)
  rampUpDurationHours Int                @default(24)
  shieldMode          String             @default("server") // server, client_shield, hybrid
  datacenterBlocked   Boolean            @default(true)
  safePageProxyMode   Boolean            @default(false)
  rules               TrafficRule[]
  logs                TrafficLog[]
  pixelConfig         TrafficPixelConfig?
  pixelLogs           TrafficPixelLog[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  company             Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([slug])
}

model TrafficDirectorSubscription {
  id                 String    @id @default(uuid())
  companyId          String    @unique
  planTier           String    @default("FREE") // FREE, STARTER, PRO, ENTERPRISE
  maxLinks           Int       @default(2)
  status             String    @default("ACTIVE") // ACTIVE, PAST_DUE, CANCELLED
  oneEightySubId     String?
  amountCharged      Float     @default(0)
  currency           String    @default("USD")
  couponApplied      String?
  discountAmount     Float     @default(0)
  trialStartedAt     DateTime?
  trialEndsAt        DateTime?
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime?
  nextBillingDate    DateTime?
  autoRenew          Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
}

model TrafficRule {
  id             String      @id @default(uuid())
  linkId         String
  name           String
  priority       Int         @default(0)
  isActive       Boolean     @default(true)
  destinationUrl String
  actionType     String      @default("redirect_302") // redirect_302, redirect_301, redirect_307, rewrite
  conditions     Json        // Array of condition criteria: { type: 'geo'|'device'|'header'|'query'|'bot'|'time'|'network_type'|'asn_provider'|'touch_support'|'gpu_renderer'|'battery_valid', operator: 'equals'|'not_equals'|'contains'|'in', value: any }
  weight         Int         @default(100)
  matchCount     Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  link           TrafficLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  companyId      String?
  company        Company?    @relation("CompanyTrafficRules", fields: [companyId], references: [id], onDelete: Cascade)

  @@index([linkId])
  @@index([priority])
  @@index([companyId])
}

model TrafficLog {
  id             String      @id @default(uuid())
  linkId         String
  ruleId         String?
  ipAddress      String?
  country        String?
  city           String?
  deviceType     String?
  os             String?
  browser        String?
  userAgent      String?
  referrer       String?
  isBot          Boolean     @default(false)
  botName        String?
  networkType    String?     // residential, datacenter, cellular, vpn
  gpuRenderer    String?
  touchPoints    Int?
  batteryLevel   Float?
  isEmulated     Boolean     @default(false)
  destinationUrl String
  responseStatus Int         @default(302)
  latencyMs      Int         @default(0)
  timestamp      DateTime    @default(now())

  link           TrafficLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  companyId      String?
  company        Company?    @relation("CompanyTrafficLogs", fields: [companyId], references: [id], onDelete: Cascade)

  @@index([linkId, timestamp])
  @@index([timestamp])
  @@index([companyId])
}

model TrafficPixelConfig {
  id             String              @id @default(uuid())
  linkId         String              @unique
  companyId      String
  masterPixelId  String
  backupPixelIds String[]            @default([])
  capiTokenEnc   String?
  testEventCode  String?
  enableCapi     Boolean             @default(true)
  fireOnBots     Boolean             @default(false)
  trackPageViews Boolean             @default(true)
  trackOutbound  Boolean             @default(true)
  events         TrafficPixelEvent[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  link           TrafficLink         @relation(fields: [linkId], references: [id], onDelete: Cascade)
  company        Company             @relation("CompanyTrafficPixelConfigs", fields: [companyId], references: [id], onDelete: Cascade)

  @@index([linkId])
  @@index([companyId])
}

model TrafficPixelEvent {
  id            String             @id @default(uuid())
  configId      String
  eventName     String
  triggerType   String
  selector      String?
  urlPattern    String?
  eventValueKey String?
  currency      String             @default("USD")
  isEnabled     Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  config        TrafficPixelConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId])
}

model TrafficPixelLog {
  id             String      @id @default(uuid())
  linkId         String
  companyId      String?
  pixelId        String
  eventId        String
  eventName      String
  deliverySource String
  browserFired   Boolean     @default(false)
  capiFired      Boolean     @default(false)
  capiStatus     String?
  capiLatencyMs  Int?
  isBotFiltered  Boolean     @default(false)
  ipAddress      String?
  userAgent      String?
  fbp            String?
  fbc            String?
  timestamp      DateTime    @default(now())

  link           TrafficLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  company        Company?    @relation("CompanyTrafficPixelLogs", fields: [companyId], references: [id], onDelete: Cascade)

  @@index([linkId, timestamp])
  @@index([eventId])
  @@index([companyId])
}
