// =============================================================================
// 180 SOCIAL MEDIA MANAGEMENT SUITE (WORK GRAPH & OAUTH 2.0 PROTOCOLS)
// =============================================================================

model SocialAccount {
  id                  String               @id @default(uuid())
  companyId           String
  clientId            String?
  projectId           String?
  platform            String               // "instagram", "facebook", "linkedin", "tiktok", "youtube"
  platformAccountId   String
  accountName         String
  username            String
  profileImageUrl     String?
  /// DEPRECATED plaintext columns. New tokens live encrypted in SocialAccountCredential (WS4 token vault);
  /// these stay null for new rows and are cleared by `SocialTokenVault.migrateLegacyPlaintextTokens()`.
  accessToken         String?              @db.Text
  refreshToken        String?              @db.Text
  tokenExpiresAt      DateTime?
  scopes              String[]             @default([])
  metadata            Json?                @default("{}")
  capabilities        Json?                @default("{\"canPublishReels\":true,\"canPublishPosts\":true,\"canPublishStories\":false,\"canReadInbox\":true,\"canComment\":true}")
  reauthRequired      Boolean              @default(false)
  reauthReason        String?              @db.Text
  lastHealthCheckAt   DateTime?
  isActive            Boolean              @default(true)
  /// AI inbox: off | reply (answer every DM) | qualify (qualify the lead, then hand off). A thread a human took over
  /// is never answered by the AI.
  aiInboxMode         String               @default("off")
  /// Extra instructions for the AI inbox of this account (offer, ideal customer, qualification criteria).
  aiInboxInstructions String?              @db.Text
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  company             Company              @relation("CompanySocialAccounts", fields: [companyId], references: [id], onDelete: Cascade)
  client              Client?              @relation("ClientSocialAccounts", fields: [clientId], references: [id], onDelete: SetNull)
  project             Project?             @relation("ProjectSocialAccounts", fields: [projectId], references: [id], onDelete: SetNull)
  posts               SocialPost[]         @relation("AccountSocialPosts")
  conversations       SocialConversation[] @relation("AccountSocialConversations")
  credential          SocialAccountCredential?
  postVariants        SocialPostVariant[]  @relation("AccountPostVariants")
  publishAttempts     SocialPublishAttempt[] @relation("AccountPublishAttempts")
  engagementRules     SocialEngagementRule[] @relation("AccountSocialEngagementRules")

  @@unique([companyId, platform, platformAccountId])
  @@index([companyId, projectId])
  @@index([companyId, platform])
}

model BrandVoiceProfile {
  id                  String               @id @default(uuid())
  companyId           String
  projectId           String               @unique
  tone                String               @default("Professional & Insightful")
  targetAudience      String               @default("General Audience")
  sampleViralPosts    String[]             @default([])
  forbiddenWords      String[]             @default([])
  defaultHashtags     String[]             @default([])
  standardCtas        String[]             @default([])
  metadata            Json?                @default("{}")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  company             Company              @relation("CompanyBrandVoiceProfiles", fields: [companyId], references: [id], onDelete: Cascade)
  project             Project              @relation("ProjectBrandVoiceProfile", fields: [projectId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model SocialPost {
  id                  String                @id @default(uuid())
  companyId           String
  clientId            String?
  projectId           String?
  calendarId          String?
  calendarPieceId     String?               @unique
  socialAccountId     String?
  createdById         String?
  title               String?
  content             String                @db.Text
  mediaUrls           String[]              @default([])
  rawMediaUrls        String[]              @default([])
  finalVideoUrl       String?
  thumbnailUrl        String?
  mediaType           String                @default("video") // "video", "image", "carousel", "document"
  status              String                @default("draft") // "draft", "in_editing", "in_review", "approved", "scheduled", "publishing", "published", "failed"
  scheduledFor        DateTime?
  publishedAt         DateTime?
  errorMessage        String?
  publishedLinks      Json?                 @default("{}")
  metadata            Json?                 @default("{}")
  versionNumber       Int                   @default(1)
  approvedVersion     Int?
  revisionNotes       String?               @db.Text
  externalStorageLinks Json?                @default("[]")
  history             Json?                 @default("[]")
  repurposedFromId    String?
  isEvergreen         Boolean               @default(false)
  lastReusedAt        DateTime?
  reuseCount          Int                   @default(0)
  publishAttemptCount Int                   @default(0)
  nextPublishAttemptAt DateTime?
  publishLeaseUntil   DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  company             Company               @relation("CompanySocialPosts", fields: [companyId], references: [id], onDelete: Cascade)
  client              Client?               @relation("ClientSocialPosts", fields: [clientId], references: [id], onDelete: SetNull)
  project             Project?              @relation("ProjectSocialPosts", fields: [projectId], references: [id], onDelete: SetNull)
  calendar            ContentCalendar?      @relation("CalendarSocialPosts", fields: [calendarId], references: [id], onDelete: SetNull)
  calendarPiece       CalendarContentPiece? @relation("PieceSocialPost", fields: [calendarPieceId], references: [id], onDelete: SetNull)
  socialAccount       SocialAccount?        @relation("AccountSocialPosts", fields: [socialAccountId], references: [id], onDelete: SetNull)
  repurposedFrom      SocialPost?           @relation("RepurposedPosts", fields: [repurposedFromId], references: [id], onDelete: SetNull)
  derivedPosts        SocialPost[]          @relation("RepurposedPosts")
  variants            SocialPostVariant[]
  reviewComments      PostReviewComment[]
  publishAttempts     SocialPublishAttempt[]
  engagementRules     SocialEngagementRule[] @relation("PostSocialEngagementRules")
  videoIntelligence   PostVideoIntelligence?

  @@index([companyId, status])
  @@index([companyId, projectId])
  @@index([companyId, scheduledFor])
  @@index([status, scheduledFor])
  @@index([status, nextPublishAttemptAt])
}

model SocialPostVariant {
  id                  String               @id @default(uuid())
  postId              String
  platform            String               // "instagram", "facebook", "linkedin", "tiktok", "youtube"
  customContent       String               @db.Text
  customMediaUrls     String[]             @default([])
  firstComment        String?              @db.Text
  platformMeta        Json?                @default("{}")
  /// Target account for this variant; null = the post's account, else the project's only active account of this platform.
  socialAccountId     String?
  publishStatus       String               @default("pending") // "pending", "publishing", "processing", "published", "failed"
  externalId          String?
  externalUrl         String?              @db.Text
  publishedAt         DateTime?
  lastError           String?              @db.Text
  lastErrorCode       String?
  lastErrorRetryable  Boolean              @default(false)
  attemptCount        Int                  @default(0)
  publishLeaseUntil   DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @default(now()) @updatedAt

  post                SocialPost           @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialAccount       SocialAccount?       @relation("AccountPostVariants", fields: [socialAccountId], references: [id], onDelete: SetNull)
  publishAttempts     SocialPublishAttempt[]

  @@index([postId, platform])
  @@index([publishStatus, platform])
}

/// WS4 token vault: provider OAuth tokens, AES-256-GCM encrypted at rest (key: SOCIAL_TOKEN_ENCRYPTION_KEY).
/// Never included by account listing endpoints; only the publishing pipeline decrypts it.
model SocialAccountCredential {
  id                    String        @id @default(uuid())
  companyId             String
  socialAccountId       String        @unique
  accessTokenEnc        String        @db.Text
  refreshTokenEnc       String?       @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  tokenType             String?
  scopes                String[]      @default([])
  keyId                 String
  lastRefreshedAt       DateTime?
  refreshFailureCount   Int           @default(0)
  lastRefreshError      String?       @db.Text
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  socialAccount         SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([accessTokenExpiresAt])
  @@map("social_account_credentials")
}

/// One OAuth connect attempt: binds the signed `state` nonce to tenant, user, redirect and PKCE verifier (one-time use).
/// For Meta / LinkedIn it also holds the encrypted candidate pages / organisations until the user picks them.
model SocialOAuthSession {
  id                  String        @id @default(uuid())
  companyId           String
  userId              String
  projectId           String?
  platform            String
  client              String        @default("web") // "web", "mobile"
  redirectUri         String        @db.Text
  codeVerifierEnc     String?       @db.Text
  candidatesEnc       String?       @db.Text
  status              String        @default("pending") // "pending", "awaiting_selection", "completed", "failed"
  error               String?       @db.Text
  expiresAt           DateTime
  consumedAt          DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([companyId, userId])
  @@index([expiresAt])
  @@map("social_oauth_sessions")
}

/// Publish history: one row per platform attempt (manual publish, retry or scheduler).
model SocialPublishAttempt {
  id                  String             @id @default(uuid())
  companyId           String
  postId              String
  variantId           String?
  platform            String
  socialAccountId     String?
  trigger             String             // "manual", "retry", "scheduler"
  attemptNumber       Int                @default(1)
  status              String             @default("started") // "started", "succeeded", "processing", "failed"
  externalId          String?
  externalUrl         String?            @db.Text
  errorCode           String?
  errorMessage        String?            @db.Text
  retryable           Boolean            @default(false)
  triggeredById       String?
  startedAt           DateTime           @default(now())
  finishedAt          DateTime?

  post                SocialPost         @relation(fields: [postId], references: [id], onDelete: Cascade)
  variant             SocialPostVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  socialAccount       SocialAccount?     @relation("AccountPublishAttempts", fields: [socialAccountId], references: [id], onDelete: SetNull)

  @@index([companyId, postId])
  @@index([postId, platform])
  @@map("social_publish_attempts")
}

model ClientReviewSession {
  id                  String               @id @default(uuid())
  companyId           String
  clientId            String
  projectId           String?
  token               String               @unique @default(uuid())
  name                String
  startDate           DateTime
  endDate             DateTime
  status              String               @default("pending") // "pending", "partially_approved", "approved", "revisions_requested"
  clientNotes         String?              @db.Text
  expiresAt           DateTime
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  company             Company              @relation("CompanyClientReviewSessions", fields: [companyId], references: [id], onDelete: Cascade)
  client              Client               @relation("ClientReviewSessions", fields: [clientId], references: [id], onDelete: Cascade)
  project             Project?             @relation("ProjectClientReviewSessions", fields: [projectId], references: [id], onDelete: SetNull)
  comments            PostReviewComment[]

  @@index([companyId, clientId])
  @@index([token])
}

model PostReviewComment {
  id                  String               @id @default(uuid())
  postId              String
  sessionId           String?
  authorName          String
  authorType          String               @default("client") // "client", "agency_team"
  commentText         String               @db.Text
  resolved            Boolean              @default(false)
  createdAt           DateTime             @default(now())

  post                SocialPost           @relation(fields: [postId], references: [id], onDelete: Cascade)
  session             ClientReviewSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model SocialConversation {
  id                  String               @id @default(uuid())
  companyId           String
  projectId           String?
  socialAccountId     String
  platform            String               // "instagram", "facebook", "linkedin", "tiktok", "youtube"
  platformThreadId    String
  participantName     String
  participantHandle   String
  participantAvatar   String?
  lastMessageSnippet  String?              @db.Text
  lastMessageAt       DateTime             @default(now())
  isRead              Boolean              @default(false)
  aiAgentActive       Boolean              @default(false) // opt-in: a rule with actionEnableAiAgent or a manual toggle
  isHumanTakeover     Boolean              @default(false)
  convertedLeadId     String?
  /// Lead qualification written by the AI inbox agent: 0-100 and new | engaged | qualified | disqualified | handoff.
  leadScore           Int?
  leadStage           String?
  /// { need, budget, timeline, authority, fit, reason }; values are what the person said, never inferred numbers.
  leadQualification   Json?
  leadQualifiedAt     DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  company             Company              @relation("CompanySocialConversations", fields: [companyId], references: [id], onDelete: Cascade)
  project             Project?             @relation("ProjectSocialConversations", fields: [projectId], references: [id], onDelete: SetNull)
  socialAccount       SocialAccount        @relation("AccountSocialConversations", fields: [socialAccountId], references: [id], onDelete: Cascade)
  messages            SocialMessage[]

  @@unique([companyId, platform, platformThreadId])
  @@index([companyId, projectId])
  @@index([companyId, leadStage])
}

model SocialMessage {
  id                  String               @id @default(uuid())
  conversationId      String
  senderType          String               // "participant", "agent", "ai_bot"
  content             String               @db.Text
  platformMessageId   String?
  createdAt           DateTime             @default(now())

  conversation        SocialConversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model EvergreenQueueSlot {
  id                  String               @id @default(uuid())
  companyId           String
  projectId           String
  dayOfWeek           Int                  // 0 (Sun) to 6 (Sat)
  timeSlotUtc         String               // "14:30"
  category            String               // "Case Study", "Educational Carousel", "Short Reel"
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  company             Company              @relation("CompanyEvergreenQueueSlots", fields: [companyId], references: [id], onDelete: Cascade)
  project             Project              @relation("ProjectEvergreenQueueSlots", fields: [projectId], references: [id], onDelete: Cascade)

  @@index([companyId, projectId])
}

model SocialEngagementRule {
  id                      String                  @id @default(uuid())
  companyId               String
  projectId               String?
  socialAccountId         String?
  postId                  String?                 // Target specific post/reel, or null for account-wide
  /// Platform media id of a post published outside 180 Workspace (requires socialAccountId); matched against the
  /// webhook's media id. Null with postId null = every post of the account.
  platformMediaId         String?
  platformMediaPermalink  String?                 @db.Text
  platformMediaThumbnail  String?                 @db.Text
  name                    String                  // e.g. "Viral Reel Blueprint Auto-DM"
  status                  String                  @default("active") // "active", "paused", "archived"
  
  // Triggers
  triggerType             String                  // "comment_keyword", "comment_any", "dm_inbound", "mention"
  triggerKeywords         String[]                @default([])       // e.g. ["WORKFLOW", "LINK", "INFO"]
  matchMode               String                  @default("contains") // "contains", "exact", "regex"
  
  // Actions
  actionAutoLike          Boolean                 @default(true)
  actionPublicReplies     String[]                @default([])       // Rotating reply templates to prevent spam flags
  actionSendDm            Boolean                 @default(true)
  actionDmTemplate        String                  @db.Text           // DM copy with {name}, {handle}, {deliverable_link}
  actionDmDeliverableUrl  String?                 // e.g. "https://180workspace.com/blueprint"
  actionDmButtons         Json?                   @default("[]")     // Quick-reply buttons or link pills
  
  // Conversational AI Agent Follow-Up
  actionEnableAiAgent     Boolean                 @default(true)     // Let AI take over multi-turn conversation
  aiAgentGoal             String                  @default("qualify_lead") // "qualify_lead", "answer_support", "book_demo"
  aiAgentPromptOverride   String?                 @db.Text
  
  // Telemetry & Conversion Counters
  statsTriggeredCount     Int                     @default(0)
  statsDmsSentCount       Int                     @default(0)
  statsCommentsLiked      Int                     @default(0)
  statsLeadsConverted     Int                     @default(0)
  
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  company                 Company                 @relation("CompanySocialEngagementRules", fields: [companyId], references: [id], onDelete: Cascade)
  project                 Project?                @relation("ProjectSocialEngagementRules", fields: [projectId], references: [id], onDelete: SetNull)
  socialAccount           SocialAccount?          @relation("AccountSocialEngagementRules", fields: [socialAccountId], references: [id], onDelete: SetNull)
  socialPost              SocialPost?             @relation("PostSocialEngagementRules", fields: [postId], references: [id], onDelete: SetNull)
  logs                    SocialInteractionLog[]

  @@index([companyId, status])
  @@index([companyId, projectId])
  @@index([socialAccountId, triggerType])
  @@index([postId])
  @@index([socialAccountId, platformMediaId])
}

model SocialInteractionLog {
  id                      String                  @id @default(uuid())
  companyId               String
  ruleId                  String
  socialAccountId         String
  platform                String                  // "instagram", "facebook", "twitter", "threads", "youtube", "linkedin"
  platformCommentId       String?
  platformMessageId       String?
  platformMediaId         String?                 // post / reel the comment belongs to (one DM per user per post)
  recipientId             String                  // platform user ID or IGSID
  recipientHandle         String
  status                  String                  // "success", "failed", "rate_limited", "duplicate_skipped"
  commentLiked            Boolean                 @default(false)
  publicReplySent         String?                 @db.Text
  dmSent                  String?                 @db.Text
  errorMessage            String?                 @db.Text
  payload                 Json?                   // deferred (rate-limited) event, replayed by retryDeferred()
  attempts                Int                     @default(0)
  nextAttemptAt           DateTime?
  createdAt               DateTime                @default(now())

  rule                    SocialEngagementRule    @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([companyId, ruleId])
  @@index([platform, recipientId, platformCommentId])
  @@index([companyId, ruleId, recipientId, platformMediaId])
  @@index([status, nextAttemptAt])
}


model AgentRunEvent {
  id        String   @id @default(uuid())
  runId     String
  projectId String?
  companyId String
  agent     String
  seq       Int      @default(0)
  type      String
  payload   Json     @default("{}")
  ts        DateTime
  createdAt DateTime @default(now())

  @@index([companyId, projectId])
  @@index([runId])
  @@index([ts])
}

/// Per-project agent memory (P4): accepted/rejected proposals, explicit creator preferences and performance
/// history. Strictly scoped by companyId + projectId; read compactly into strategist and Director prompts.
model AgentMemory {
  id        String   @id @default(uuid())
  companyId String
  projectId String
  /// proposal_accepted | proposal_rejected | preference | performance
  kind      String
  /// director | strategist | all
  scope     String   @default("all")
  /// Dedupe key for preferences (e.g. "zoom", "captions.size"); a newer value replaces the older one.
  key       String?
  text      String
  payload   Json?
  weight    Float    @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, projectId, kind])
  @@index([companyId, projectId, key])
}

/// Project-scoped semantic library index (transcripts, scenes, OCR, captions of the user's own media).
/// Media never leaves the device: rows hold text + timings sent by the client, not media.
model MediaIndexEntry {
  id        String   @id @default(uuid())
  companyId String
  projectId String
  assetId   String
  /// transcript | scene | ocr | caption
  kind      String
  text      String
  startMs   Int?
  endMs     Int?
  url       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, projectId])
  @@index([companyId, projectId, assetId, kind])
}

model ManagerConversation {
  id              String           @id @default(uuid())
  companyId       String
  projectId       String?
  title           String           @default("180 Manager Chat")
  summary         String?          @db.Text
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  messages        ManagerMessage[]
  company         Company          @relation("CompanyManagerConversations", fields: [companyId], references: [id], onDelete: Cascade)
  project         Project?         @relation("ProjectManagerConversations", fields: [projectId], references: [id], onDelete: SetNull)

  @@index([companyId, projectId])
}

model ManagerMessage {
  id               String               @id @default(uuid())
  conversationId   String
  senderType       String               // "user" | "manager" | "system"
  content          String               @db.Text
  intent           String?              // "analytics", "calendar_update", "inbox_hunt", "director_rule", "video_intel"
  suggestedActions Json?                @default("[]")
  delegatedAgent   String?              // "calendar" | "inbox" | "analytics" | "director" | "video_intel"
  tokenUsage       Int                  @default(0)
  createdAt        DateTime             @default(now())

  conversation     ManagerConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model PostVideoIntelligence {
  id                   String       @id @default(uuid())
  companyId            String
  projectId            String
  postId               String?      @unique
  assetUrl             String?
  durationSec          Float?
  hookScore            Int          @default(0) // 0 - 100
  visualHookAnalysis   String?      @db.Text
  audioHookTranscript  String?      @db.Text
  pacingScore          Int          @default(0) // 0 - 100
  cutsPerMinute        Float?
  energyLevel          String?      // "high", "medium", "calm"
  detectedFormat       String?      // "talking_head", "tutorial", "breakdown", "meme", "lifestyle"
  speechTranscript     String?      @db.Text
  viralityHypothesis   String?      @db.Text
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  company              Company      @relation("CompanyPostVideoIntelligences", fields: [companyId], references: [id], onDelete: Cascade)
  project              Project      @relation("ProjectPostVideoIntelligences", fields: [projectId], references: [id], onDelete: Cascade)
  post                 SocialPost?  @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([companyId, projectId])
}

/// Studio library folder (metadata only; media files stay on the device that recorded them).
model StudioMediaFolder {
  id         String    @id
  companyId  String
  projectId  String?
  name       String
  colorValue BigInt    @default(4283385573)
  parentId   String?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([companyId, projectId])
}

/// Studio library item: clip/photo/note metadata, piece link and take order. `localPath` is only meaningful on
/// the device named by `deviceId`; the file itself is never uploaded by the library sync.
model StudioMediaAsset {
  id            String    @id
  companyId     String
  projectId     String?
  folderId      String?
  pieceId       String?
  name          String
  type          String
  durationMs    Int       @default(0)
  fileSizeBytes BigInt    @default(0)
  takeIndex     Int?
  tags          String[]  @default([])
  noteContent   String?   @db.Text
  noteCategory  String?
  deviceId      String?
  localPath     String?   @db.Text
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([companyId, projectId])
  @@index([companyId, pieceId])
}

