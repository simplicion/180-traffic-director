  createdAt DateTime @default(now())
}

model UserSkill {
  id        String   @id @default(uuid())
  userId    String
  skillName String
  isCustom  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserResume {
  id         String   @id @default(uuid())
  userId     String
  fileUrl    String
  fileName   String
  uploadedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserProject {
  id          String    @id @default(uuid())
  userId      String
  name        String
  description String?
  url         String?
  startDate   DateTime?
  endDate     DateTime?
  isOngoing   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Event {
  id               String              @id @default(uuid())
  title            String
  description      String              @default("")
  eventType        String              @default("in-person")
  location         String              @default("")
  eventDate        DateTime
  registrationLink String?
  bannerImage      String?
  capacity         Int?
  tags             String[]            @default([])
  status           String              @default("upcoming")
  customFields     Json?               @default("[]")
  companyId        String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  company          Company             @relation("CompanyEvents", fields: [companyId], references: [id])
  registrations    EventRegistration[]

  @@index([companyId, status])
  @@index([companyId, id])
  @@index([companyId, createdAt])
}

model EventRegistration {
  id         String   @id @default(uuid())
  eventId    String
  name       String
  email      String
  phone      String?
  customData Json?    @default("{}")
  createdAt  DateTime @default(now())
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

// =============================================================================
// CRM & SALES MODELS
// =============================================================================

model Lead {
  id                 String    @id @default(uuid())
  name               String
  email              String?
  phone              String?
  company            String?
  companyName        String?
  industry           String?
  companySize        Int?
  source             String?
  status             String    @default("new")
  value              Float?    @default(0)
  leadScore          Int?      @default(0)
  engagementScore    Int?      @default(0)
  assignedSalesRepId String?
  assignedSalesRep   User?     @relation("DealAssignedRep", fields: [assignedSalesRepId], references: [id])
  notes              String?   @db.Text
  followUpDate       DateTime?
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  category           String?


  deals           Deal[]          @relation("LeadDeal")
  salesActivities SalesActivity[] @relation("ActivityDeal")
  salesTasks      SalesTask[]     @relation("TaskDeal")
  // @@map("Lead")
  companyId   String?
  tenantCompany Company? @relation("CompanyLeads", fields: [companyId], references: [id], onDelete: Cascade)


  @@index([status])
  @@index([assignedSalesRepId])
  @@index([createdAt(sort: Desc), id])
  @@index([companyId])
}

model Deal {
  id                String    @id @default(uuid())
  title             String
  source            String?
  clientId          String?
  client            Client?   @relation("ClientDeals", fields: [clientId], references: [id], onDelete: SetNull)
  leadId            String?   @map("leadId")
  lead              Lead?     @relation("LeadDeal", fields: [leadId], references: [id], onDelete: SetNull)
  ownerId           String?
  owner             User?     @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  value             Float?    @default(0)
  stage             String    @default("Lead")
  pipelineType      String    @default("DEAL")
  probability       Float?    @default(0)
  engagementScore   Int?      @default(0)
  priorityScore     Float?    @default(0)
  expectedCloseDate DateTime?
  notes             String?   @db.Text
  followUpDate      DateTime?
  tags              Json?     @default("[]")
  projectId         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  salesActivities SalesActivity[] @relation("ActivityLead")
  salesTasks      SalesTask[]     @relation("TaskLead")
  documents       Document[]      @relation("DealDocuments")
  companyId   String?
  company     Company? @relation("CompanyDeals", fields: [companyId], references: [id], onDelete: Cascade)


  @@index([stage])
  @@index([ownerId])
  @@index([clientId])
  @@index([pipelineType, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc), id])
  @@map("Opportunity")
  @@index([companyId])
}

model SalesActivity {
  id              String    @id @default(uuid())
  type            String    @default("note")
  notes           String?
  timestamp       DateTime  @default(now())
  ownerId         String?
  owner           User?     @relation("SalesActivityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  leadId          String?   @map("relatedLeadId")
  lead            Lead?     @relation("ActivityDeal", fields: [leadId], references: [id], onDelete: SetNull)
  dealId          String?   @map("relatedDealId")
  deal            Deal?     @relation("ActivityLead", fields: [dealId], references: [id], onDelete: SetNull)
  relatedClientId String?
  relatedClient   Client?   @relation("ActivityClient", fields: [relatedClientId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  status          String    @default("pending")
  reviewComment   String?
  reviewedById    String?
  reviewedAt      DateTime?
  companyId   String?
  company     Company? @relation("CompanySalesActivities", fields: [companyId], references: [id], onDelete: Cascade)


  @@index([ownerId])
  @@index([dealId])
  @@index([leadId])
  @@index([companyId])
}

model SalesForecast {
  id              String   @id @default(uuid())
  period          String
  type            String   @default("monthly")
  expectedRevenue Float?   @default(0)
  weightedRevenue Float?   @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  companyId   String?
  company     Company? @relation("CompanySalesForecasts", fields: [companyId], references: [id], onDelete: Cascade)


  @@unique([period, type], name: "period_type")
  @@index([companyId])
}

model SalesTask {
  id          String    @id @default(uuid())
  description String?
  status      String    @default("pending")
  dueDate     DateTime?
  assignedTo  String?
  leadId      String?   @map("relatedLeadId")
  lead        Lead?     @relation("TaskDeal", fields: [leadId], references: [id], onDelete: SetNull)
  dealId      String?   @map("relatedDealId")
  deal        Deal?     @relation("TaskLead", fields: [dealId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  companyId   String?
  company     Company? @relation("CompanySalesTasks", fields: [companyId], references: [id], onDelete: Cascade)


  @@index([assignedTo, status])
  @@index([companyId])
}

model Quote {
  id            String    @id @default(uuid())
  quoteNumber   String    @unique
  clientId      String?
  opportunityId String?
  companyId     String?
  createdById   String?
  createdBy     User?     @relation("QuoteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items         Json?     @default("[]")
  subtotal      Float?    @default(0)
  tax           Float?    @default(0)
  discount      Float?    @default(0)
  grandTotal    Float?    @default(0)
  validUntil    DateTime?
  status        String    @default("draft")
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([companyId])
  @@index([clientId])
  @@index([companyId, id])
  @@index([companyId, createdAt])
}

model Form {
  id          String   @id @default(uuid())
  companyId   String
  title       String
  description String?
  slug        String   @unique
  isActive    Boolean  @default(true)
  formType    String   @default("GENERAL_SURVEY") // "GENERAL_SURVEY" | "SALES_ACTIVITY"
  formCode    String?
  apiKey      String?  @unique
  settings    Json?    @default("{}")
  viewsCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fields      FormField[]
  submissions FormSubmission[]

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, id])
  @@index([companyId, createdAt])
  @@index([apiKey])
  @@index([formType])
}

model FormField {
  id          String  @id @default(uuid())
  formId      String
  label       String
  type        String // TEXT, EMAIL, PHONE, NUMBER, TEXTAREA, RADIO, SELECT, CHECKBOX, FILE_UPLOAD, DATE, DATETIME, RATING, HEADING, PARAGRAPH, DIVIDER
  required    Boolean @default(false)
  placeholder String?
  description String?
  options     Json? // For SELECT, RADIO, CHECKBOX, RATING
  validation  Json? // For min, max, fileTypes, maxSizeMB
  order       Int     @default(0)
  mapping     String? // e.g. "contactName", "contactEmail", "companyName", "industry", "source", "phone"

  form   Form                  @relation(fields: [formId], references: [id], onDelete: Cascade)
  values FormSubmissionValue[]

  @@index([formId])
}

model FormSubmission {
  id          String   @id @default(uuid())
  formId      String
  companyId   String
  submittedAt DateTime @default(now())
  ipAddress   String?
  userAgent   String?
  referrer    String?

  leadId   String? // Reference to the created Lead
  clientId String? // Reference to the created Client

  form   Form                  @relation(fields: [formId], references: [id], onDelete: Cascade)
  values FormSubmissionValue[]

  @@index([formId])
  @@index([companyId])
  @@index([companyId, id])
}

model FormSubmissionValue {
  id           String  @id @default(uuid())
  submissionId String
  fieldId      String
  value        String? @db.Text
  fileUrl      String?
  fileName     String?

  submission FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  field      FormField      @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([fieldId])
}

// -----------------------------------------------------------------------------
// Advertising & Website Module
// -----------------------------------------------------------------------------

model Website {
  id        String  @id @default(uuid())
  companyId String? // Optional for now to not break existing data, strict data isolation

  name         String
  slug         String   @unique
  customDomain String?  @unique
  template     String?
  config       Json?    @default("{}") // Stores hero, colors, etc.
  publishedConfig Json?
  isPublished  Boolean  @default(false)
  owner        String
  status       String   @default("active")
  stats        Json?    @default("{}") // { views: number, leads: number }
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pixels      Pixel[]
  submissions WebsiteFormSubmission[]

  @@index([companyId, id])
  @@index([companyId, createdAt])
}

model Pixel {
  id        String   @id @default(uuid())
  websiteId String
  provider  String // e.g., facebook, google, tiktok
  pixelId   String
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  companyId   String?
  company     Company? @relation("CompanyPixels", fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model WebsiteFormSubmission {
  id        String   @id @default(uuid())
  websiteId String
  name      String?
  email     String?
  phone     String?
  message   String?  @db.Text
  data      Json?
  status    String   @default("new")
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  companyId   String?
  company     Company? @relation("CompanyWebsiteFormSubmissions", fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model KnowledgeArticle {
  id       String   @id @default(uuid())
  title    String
  content  String
  category String   @default("General")
  tags     String[] @default([])

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  createdById String
  createdBy   User   @relation("KnowledgeCreatedBy", fields: [createdById], references: [id])

  updatedById String?
  updatedBy   User?   @relation("KnowledgeUpdatedBy", fields: [updatedById], references: [id])

  lockedById String?
  lockedBy   User?     @relation("KnowledgeLockedBy", fields: [lockedById], references: [id])
  lockedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions KnowledgeArticleVersion[]
  links    KnowledgeArticleLink[]

  @@index([companyId, id])
  @@index([companyId, createdAt])
}

model KnowledgeArticleVersion {
  id            String           @id @default(uuid())
  articleId     String
  article       KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  content       String
  changeSummary String?
  createdById   String
  createdBy     User             @relation("KnowledgeVersionCreator", fields: [createdById], references: [id])
  createdAt     DateTime         @default(now())
}

model KnowledgeArticleLink {
  id        String           @id @default(uuid())
  articleId String
  article   KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  relatedModel String
  relatedId    String

  createdAt DateTime @default(now())

  @@unique([articleId, relatedModel, relatedId])
}

model TeamActivityLog {
  id         String   @id @default(uuid())
  companyId  String
  actorId    String
  actionType String
  entityId   String?
  entityType String?
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actor   User    @relation("UserTeamActivityLogs", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([actorId])
  @@index([createdAt])
}

model ProcessedWebhook {
  id        String   @id @default(uuid())
  eventId   String   @unique
  provider  String   @default("razorpay")
  status    String   @default("processed")
  createdAt DateTime @default(now())

  @@index([eventId])
}

model DomainRegistry {
  id               String    @id @default(uuid())
  domain           String    @unique
  type             String    // 'ADVERTISING_WEBSITE' | 'TRAFFIC_LINK' | 'COMPANY_PROFILE'
  targetId         String    // websiteId, linkId, or companyId
  companyId        String?
  status           String    @default("PENDING_VERIFICATION") // 'PENDING_VERIFICATION' | 'ACTIVE' | 'FAILED' | 'REMOVED'
  sslStatus        String    @default("PENDING")              // 'PENDING' | 'ACTIVE' | 'FAILED'
  isApex           Boolean   @default(false)
  verificationData Json?     @default("{}")
  verifiedAt       DateTime?
  lastCheckedAt    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([domain])
  @@index([companyId])
  @@index([type, targetId])
}

// ------------------------------------------------------
// MARKETING & CMS MODELS (AEO/SEO Optimized)
// ------------------------------------------------------

model MarketingPage {
  id   String @id @default(uuid())
  slug String @unique // e.g., 'features/hr-management'
  type String @default("FEATURE") // FEATURE, USE_CASE, LEGAL

  // SEO Data
  seoTitle       String
  seoDescription String
  keywords       String[]
  jsonLdSchema   Json? // Injected directly into <head>

  // Page Content (JSON structure for Astro to render modular blocks)
  heroHeadline  String
  heroSubtext   String
  heroImageUrl  String?
  contentBlocks Json // Array of feature blocks, testimonials, FAQs

  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MarketingBlog {
  id       String   @id @default(uuid())
  slug     String   @unique
  category String   // e.g., 'Operations', 'Growth & Ads', 'Architecture', 'Finance', 'AI'
  tags     String[] @default([])

  // SEO Data & Generative Engine Optimization (GEO)
  seoTitle       String
  seoDescription String
  keywords       String[]
  canonicalUrl   String?
  ogImageUrl     String?
  noIndex        Boolean  @default(false)

  // Content
  title           String
  excerpt         String
  contentMarkdown String    @default("")
  contentHtml     String    // Raw HTML or compiled Markdown
  coverImageUrl   String?
  keyTakeaways    String[]  @default([])
  readingTimeMin  Int       @default(5)

  // Author & E-E-A-T Attribution
  authorName      String
  authorRole      String
  authorAvatarUrl String?
  authorBio       String?
  authorSocial    String?

  // Product-Led Growth CTA
  relatedAppSlug String?
  ctaHeadline    String?
  ctaButtonText  String?

  // Structured Schema.org Q&A
  faqs Json?

  // Publication Lifecycle
  featured    Boolean   @default(false)
  published   Boolean   @default(false)
  publishedAt DateTime?
  viewsCount  Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MarketingFaq {
  id             String @id @default(uuid())
  question       String
  answer         String
  targetPageSlug String // Links the FAQ to a specific MarketingPage or Blog for JSON-LD generation
  order          Int    @default(0)
}

model TrafficLink {
  id                  String         @id @default(uuid())
  companyId           String
  name                String
  slug                String         @unique
  description         String?
  fallbackUrl         String
  isActive            Boolean        @default(true)
  customDomain        String?
  tags                String[]       @default([])
  totalClicks         Int            @default(0)
  warmupUntil         DateTime?
  rampUpEnabled       Boolean        @default(false)
  rampUpDurationHours Int            @default(24)
  shieldMode          String         @default("server") // server, client_shield, hybrid
  datacenterBlocked   Boolean        @default(true)
  safePageProxyMode   Boolean        @default(false)
  rules               TrafficRule[]
  logs                TrafficLog[]
  pixelConfig         TrafficPixelConfig?
  pixelLogs           TrafficPixelLog[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  company             Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([slug])
}

model TrafficDirectorSubscription {
  id                 String    @id @default(uuid())
  companyId          String    @unique
  planTier           String    @default("FREE") // FREE, STARTER, PRO, ENTERPRISE
  maxLinks           Int       @default(2)
  status             String    @default("ACTIVE") // ACTIVE, PAST_DUE, CANCELLED
  oneEightySubId     String?
  amountCharged      Float     @default(0)
  currency           String    @default("USD")
  couponApplied      String?
  discountAmount     Float     @default(0)
  trialStartedAt     DateTime?
  trialEndsAt        DateTime?
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime?
  nextBillingDate    DateTime?
  autoRenew          Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
}

model TrafficRule {
  id             String         @id @default(uuid())
  linkId         String
  name           String
  priority       Int            @default(0)
  isActive       Boolean        @default(true)
  destinationUrl String
  actionType     String         @default("redirect_302") // redirect_302, redirect_301, redirect_307, rewrite
  conditions     Json           // Array of condition criteria: { type: 'geo'|'device'|'header'|'query'|'bot'|'time'|'network_type'|'asn_provider'|'touch_support'|'gpu_renderer'|'battery_valid', operator: 'equals'|'not_equals'|'contains'|'in', value: any }
  weight         Int            @default(100)
  matchCount     Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  link           TrafficLink    @relation(fields: [linkId], references: [id], onDelete: Cascade)
  companyId   String?
  company     Company? @relation("CompanyTrafficRules", fields: [companyId], references: [id], onDelete: Cascade)


  @@index([linkId])
  @@index([priority])
  @@index([companyId])
}

model TrafficLog {
  id             String         @id @default(uuid())
  linkId         String
  ruleId         String?
  ipAddress      String?
  country        String?
  city           String?
  deviceType     String?
  os             String?
  browser        String?
  userAgent      String?
  referrer       String?
  isBot          Boolean        @default(false)
  botName        String?
  networkType    String?        // residential, datacenter, cellular, vpn
  gpuRenderer    String?
  touchPoints    Int?
  batteryLevel   Float?
  isEmulated     Boolean        @default(false)
  destinationUrl String
  responseStatus Int            @default(302)
  latencyMs      Int            @default(0)
  timestamp      DateTime       @default(now())

  link           TrafficLink    @relation(fields: [linkId], references: [id], onDelete: Cascade)
  companyId   String?
  company     Company? @relation("CompanyTrafficLogs", fields: [companyId], references: [id], onDelete: Cascade)


  @@index([linkId, timestamp])
  @@index([timestamp])
  @@index([companyId])
}

model TrafficPixelConfig {
  id              String              @id @default(uuid())
  linkId          String              @unique
  companyId       String
  masterPixelId   String
  backupPixelIds  String[]            @default([])
  capiTokenEnc    String?
  testEventCode   String?
  enableCapi      Boolean             @default(true)
  fireOnBots      Boolean             @default(false)
  trackPageViews  Boolean             @default(true)
  trackOutbound   Boolean             @default(true)
  events          TrafficPixelEvent[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  link            TrafficLink         @relation(fields: [linkId], references: [id], onDelete: Cascade)
  company         Company             @relation("CompanyTrafficPixelConfigs", fields: [companyId], references: [id], onDelete: Cascade)

  @@index([linkId])
  @@index([companyId])
}

model TrafficPixelEvent {
  id            String             @id @default(uuid())
  configId      String
  eventName     String
  triggerType   String
  selector      String?
  urlPattern    String?
  eventValueKey String?
  currency      String             @default("USD")
  isEnabled     Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  config        TrafficPixelConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId])
}

model TrafficPixelLog {
  id             String      @id @default(uuid())
  linkId         String
  companyId      String?
  pixelId        String
  eventId        String
  eventName      String
  deliverySource String
  browserFired   Boolean     @default(false)
  capiFired      Boolean     @default(false)
  capiStatus     String?
  capiLatencyMs  Int?
  isBotFiltered  Boolean     @default(false)
  ipAddress      String?
  userAgent      String?
  fbp            String?
  fbc            String?
  timestamp      DateTime    @default(now())

  link           TrafficLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  company        Company?    @relation("CompanyTrafficPixelLogs", fields: [companyId], references: [id], onDelete: Cascade)

  @@index([linkId, timestamp])
  @@index([eventId])
  @@index([companyId])
}

// ==========================================
// 180 VOICEFORCE (AUTONOMOUS VOICE AGENTS)
// ==========================================

model VoiceAgent {
  id                  String         @id @default(uuid())
  companyId           String
  company             Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  name                String         // e.g. "Maya - Sales Specialist"
  role                String         // e.g. "Order & Appointment Assistant"
  systemPrompt        String         @db.Text
  language            String         @default("en-US")
  
  // Voice Synthesis Configuration
  voiceProvider       String         @default("cartesia") // "cartesia" | "elevenlabs" | "openai"
  voiceId             String         // Provider voice ID (e.g. "sonic-english-female-1")
  voiceTemperature    Float          @default(0.7)
  voiceSpeed          Float          @default(1.0)
  
  // Pipeline Engine Selection
  engineType          String         @default("cascaded") // "cascaded" | "openai_realtime"
  llmModel            String         @default("llama-3.3-70b-versatile")
  sttModel            String         @default("nova-3")
  
  // Guardrails & Behaviors
  firstMessage        String?        @db.Text
  allowBargeIn        Boolean        @default(true)
  inactivityTimeoutMs Int            @default(5000)
  maxDurationSeconds  Int            @default(600)
  
  // Allowed Tools from aiToolRegistry (JSON Array of strings)
  enabledToolNames    Json           @default("[\"search_knowledge_base\", \"create_task\", \"create_crm_client\"]")
  
  // Call Recording & Compliance
  recordCalls         Boolean        @default(true)
  recordConsentText   String?        @default("This call may be recorded for quality and compliance purposes.")
  
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  assignedNumbers     PhoneNumber[]
  calls               CallSession[]
  campaigns           CallCampaign[]
  guardrail           VoiceAgentGuardrail?
  versions            VoiceAgentVersion[]
  linkedVaults        VoiceAgentVaultLink[]
  agentRequests       AgentRequest[]

  @@unique([id, companyId])
  @@index([companyId])
}

model PhoneNumber {
  id               String         @id @default(uuid())
  companyId        String
  company          Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  e164Number       String         @unique // e.g. "+14155552671"
  friendlyName     String?
  provider         String         // "telnyx" | "twilio" | "verified_caller_id"
  providerId       String?        // Telnyx DID or Verification ID
  
  countryCode      String         @default("US")
  capabilities     Json           @default("{\"voice\": true, \"sms\": false}")
  
  assignedAgentId  String?
  assignedAgent    VoiceAgent?    @relation(fields: [assignedAgentId], references: [id], onDelete: SetNull)
  
  status           String         @default("active") // "active" | "cooling_down" | "pending_verification"
  maxConcurrent    Int            @default(10)
  currentActive    Int            @default(0)
  routingMode      String         @default("direct_agent") // "direct_agent" | "forwarding_rule"
  
  monthlyRentalInr Float          @default(149.0)
  nextRenewalDate  DateTime?
  autoRenew        Boolean        @default(true)
  coolingDownSince DateTime?
  
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  calls            CallSession[]
  forwardingRules  ForwardingRule[]
  callCampaigns    CallCampaign[]

  @@unique([id, companyId])
  @@index([companyId])
}

model CallCampaign {
  id                String         @id @default(uuid())
  companyId         String
  company           Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  name              String
  voiceAgentId      String
  voiceAgent        VoiceAgent     @relation(fields: [voiceAgentId], references: [id], onDelete: Restrict)
  
  phoneNumberId     String?
  phoneNumber       PhoneNumber?   @relation(fields: [phoneNumberId], references: [id], onDelete: SetNull)

  status            String         @default("draft") // "draft" | "scheduled" | "running" | "paused" | "completed"
  contactList       Json?          @default("[]")
  scheduledAt       DateTime?
  campaignGoal      String?        @db.Text
  specialOffer      String?        @db.Text
  
  // Concurrency & Pacing Rules
  maxConcurrent     Int            @default(5)       // Simultaneous active calls
  callsPerSecond    Float          @default(1.0)     // CPS rate throttle
  retryCount        Int            @default(2)
  retryIntervalMins Int            @default(30)
  
  totalRecipients   Int            @default(0)
  completedCalls    Int            @default(0)
  successfulCalls   Int            @default(0)
  failedCalls       Int            @default(0)
  
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  calls             CallSession[]

  @@unique([id, companyId])
  @@index([companyId])
}

model CallSession {
  id                  String         @id @default(uuid())
  companyId           String
  company             Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  campaignId          String?
  campaign            CallCampaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  
  voiceAgentId        String
  voiceAgent          VoiceAgent     @relation(fields: [voiceAgentId], references: [id], onDelete: Restrict)
  
  phoneNumberId       String?
  phoneNumber         PhoneNumber?   @relation(fields: [phoneNumberId], references: [id], onDelete: SetNull)
  
  direction           String         @default("outbound") // "outbound" | "inbound"
  recipientPhone      String
  recipientName       String?
  
  // Telephony References
  livekitRoomName     String?        @unique
  sipCallId           String?
  
  // State Machine
  status              String         @default("queued")
  // "queued" | "dialing" | "ringing" | "in_progress" | "completed" | "no_answer" | "busy" | "failed" | "voicemail"
  
  disconnectReason    String?
  
  durationSeconds     Int            @default(0)
  billableMinutes     Int            @default(0)
  estimatedCostInr     Float          @default(0.0)
  
  // Financial Audit & Dynamic Rating (1.8x Gold Standard)
  carrierCostUsd      Float?         @default(0.0)
  engineCostUsd       Float?         @default(0.0)
  totalBilledUsd      Float?         @default(0.0)
  billedCurrency      String?        @default("USD")
  fxRateApplied       Float?         @default(1.0)
  
  recordingUrl        String?
  recordingDurationSeconds Int?
  recordingStatus     String?        @default("none") // "none" | "recording" | "ready" | "failed"
  
  // Post-Call Structured Intelligence
  summary             String?        @db.Text
  sentiment           String?
  callOutcome         String?
  actionItems         Json?          @default("[]")
  structuredData      Json?          @default("{}")
  
  startedAt           DateTime?
  answeredAt          DateTime?
  endedAt             DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  transcripts         CallTranscriptSegment[]
  toolExecutions      CallToolExecution[]
  escalationEvents    CallEscalationEvent[]
  auditLogs           ActionAuditLog[]

  @@unique([id, companyId])
  @@index([companyId, status])
  @@index([recipientPhone])
}

model CallTranscriptSegment {
  id             String       @id @default(uuid())
  callSessionId  String
  callSession    CallSession  @relation(fields: [callSessionId], references: [id], onDelete: Cascade)
  
  speaker        String       // "agent" | "user" | "system"
  text           String       @db.Text
  startTimeMs    Int
  endTimeMs      Int
  
  interrupted    Boolean      @default(false)
  createdAt      DateTime     @default(now())
  companyId   String?
  company     Company? @relation("CompanyCallTranscriptSegments", fields: [companyId], references: [id], onDelete: Cascade)


  @@index([callSessionId])
  @@index([companyId])
}

model CallToolExecution {
  id             String       @id @default(uuid())
  callSessionId  String
  callSession    CallSession  @relation(fields: [callSessionId], references: [id], onDelete: Cascade)
  
  toolName       String
  arguments      Json
  result         Json
  durationMs     Int
  isSuccess      Boolean      @default(true)
  errorMessage   String?
  
  createdAt      DateTime     @default(now())
  companyId   String?
  company     Company? @relation("CompanyCallToolExecutions", fields: [companyId], references: [id], onDelete: Cascade)


  @@index([callSessionId])
  @@index([companyId])
}

model VoiceWalletTransaction {
  id              String       @id @default(uuid())
  companyId       String
  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  amountInr       Float        // Positive for top-up, negative for call deduction
  balanceAfterInr Float
  type            String       // "topup" | "call_deduction" | "refund"
  callSessionId   String?
  paymentRef      String?
  description     String
  createdAt       DateTime     @default(now())

  @@index([companyId])
  @@index([callSessionId])
  @@index([companyId, paymentRef])
}

model DncRegistry {
  id             String       @id @default(uuid())
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  phoneNumber    String       // Normalized E.164 phone
  reason         String?      // e.g. "Customer requested opt-out during conversation"
  createdAt      DateTime     @default(now())

  @@unique([companyId, phoneNumber])
  @@index([companyId])
}

// ─── Call Forwarding & Routing Engine ─────────────────────────────────────────
model ForwardingRule {
  id                     String         @id @default(uuid())
  companyId              String
  company                Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  phoneNumberId          String
  phoneNumber            PhoneNumber    @relation(fields: [phoneNumberId], references: [id], onDelete: Cascade)
  
  name                   String         // e.g. "Agency Main Line Waterfall"
  strategy               String         @default("sequential") // "sequential" | "simultaneous" | "round_robin" | "queue_first"
  ringTimeoutSec         Int            @default(20) // Seconds to ring before cascading
  
  // JSON Array of destinations:
  // [
  //   { "type": "agent", "targetId": "uuid", "priority": 1, "timeoutSec": 20 },
  //   { "type": "phone", "e164": "+919876543210", "name": "Rajesh (Sales)", "priority": 2, "timeoutSec": 25 },
  //   { "type": "phone", "e164": "+919162051705", "name": "Amit (Backup)", "priority": 3, "timeoutSec": 20 }
  // ]
  destinations           Json           @default("[]")
  
  // Time-of-Day Schedule
  scheduleEnabled        Boolean        @default(false)
  timezone               String         @default("Asia/Kolkata")
  businessHours          Json?          // { "mon": {"start": "09:00", "end": "18:00"}, ... }
  
  // Fallback Failover
  fallbackType           String         @default("ai_agent") // "ai_agent" | "voicemail" | "queue" | "hangup"
  fallbackAgentId        String?
  fallbackVoicemailEmail String?
  
  maxHops                Int            @default(4)
  whisperAnnouncement    String?
  isActive               Boolean        @default(true)
  
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@unique([id, companyId])
  @@index([companyId, phoneNumberId])
}

// ─── Active Call Hold Queue ──────────────────────────────────────────────────
model CallQueue {
  id               String         @id @default(uuid())
  companyId        String
  company          Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  name             String         // e.g. "VIP Priority Support Queue"
  maxQueueSize     Int            @default(25)
  maxWaitTimeSec   Int            @default(300)
  holdMusicUrl     String?
  announcePosition Boolean        @default(true)
  
  currentWaiting   Int            @default(0)
  totalProcessed   Int            @default(0)
  avgWaitSeconds   Int            @default(0)
  
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([id, companyId])
  @@index([companyId])
}

// ─── AI Employee Safety Guardrails & Boundaries ──────────────────────────────
model VoiceAgentGuardrail {
  id                  String      @id @default(uuid())
  companyId           String
  voiceAgentId        String      @unique
  voiceAgent          VoiceAgent  @relation(fields: [voiceAgentId], references: [id], onDelete: Cascade)
  
  // Financial Caps
  maxDiscountPercent  Float       @default(10.0)    // Max discount AI can offer without approval
  maxDiscountAmount   Float       @default(50.0)    // Max absolute currency discount
  maxOrderValue       Float       @default(1000.0)  // Orders above this require owner approval
  
  // Booking Boundaries
  minLeadTimeHours    Int         @default(2)       // Minimum hours notice for bookings
  maxAdvanceDays      Int         @default(30)      // Max days in future to book
  bufferMinutes       Int         @default(15)      // Buffer between slots
  
  // Operational Boundaries
  maxDeliveryKm       Float?      // Max delivery radius in km
  forbiddenTopics     Json        @default("[]")    // Array of prohibited topics/competitors
  pciRedactionEnabled Boolean     @default(true)    // Auto-redact credit cards and PII
  rules               Json?       @default("{\"dos\": [], \"donts\": []}") // Strongly-typed Do's and Don'ts

  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([companyId])
}

// ─── Immutable AI Employee Configuration Versions ────────────────────────────
model VoiceAgentVersion {
  id             String      @id @default(uuid())
  companyId      String
  voiceAgentId   String
  voiceAgent     VoiceAgent  @relation(fields: [voiceAgentId], references: [id], onDelete: Cascade)
  
  versionNumber  Int
  changelog      String?
  snapshot       Json        // Full JSON dump of persona, knowledge, tools, and guardrails
  createdById    String?
  
  createdAt      DateTime    @default(now())

  @@unique([voiceAgentId, versionNumber])
  @@index([companyId, voiceAgentId])
}

// ─── Prebuilt Vertical AI Employee Blueprints ────────────────────────────────
model IndustryTemplate {
  id             String   @id @default(uuid())
  slug           String   @unique // e.g. "restaurant", "dental", "automotive", "real-estate"
  name           String
  description    String
  category       String
  icon           String?
  
  defaultConfig  Json     // Persona, sample catalog, questions to ask, objection rules, tools
  suggestedTools Json     // ["check_product_price", "book_appointment", "create_order"]
  
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
}

// ─── Zero-Repeat Warm Human Escalation Events ────────────────────────────────
model CallEscalationEvent {
  id              String       @id @default(uuid())
  companyId       String
  callSessionId   String
  callSession     CallSession  @relation(fields: [callSessionId], references: [id], onDelete: Cascade)
  
  targetType      String       // "phone" | "user" | "department"
  targetNumber    String?      // E.164 phone number
  targetUserId    String?
  
  triggerReason   String       // "sentiment_drop" | "customer_request" | "high_value_order"
  sentimentScore  Float?       // -1.0 to +1.0
  
  whisperMessage  String       // Audio whisper spoken to human agent
  briefingPayload Json         // Full structured customer context, intent, actions taken
  status          String       @default("initiated") // "initiated" | "connected" | "failed"
  
  createdAt       DateTime     @default(now())

  @@index([companyId, callSessionId])
}

// ─── Autonomous Daily Executive Performance Briefing ─────────────────────────
model DailyVoiceBriefing {
  id                 String    @id @default(uuid())
  companyId          String
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  briefingDate       DateTime  @db.Date
  
  totalCalls         Int       @default(0)
  missedCallsSaved   Int       @default(0)
  leadsCaptured      Int       @default(0)
  appointmentsBooked Int       @default(0)
  ordersCreated      Int       @default(0)
  revenueInfluenced  Float     @default(0.0)
  laborHoursSaved    Float     @default(0.0)
  
  topInquiries       Json      @default("[]") // Top 5 asked questions
  unansweredFaqs     Json      @default("[]") // Questions where AI lacked knowledge
  actionItems        Json      @default("[]") // Recommended business actions
  
  deliveredVia       Json      @default("[]") // ["email", "whatsapp", "in_app"]
  createdAt          DateTime  @default(now())

  @@unique([companyId, briefingDate])
  @@index([companyId])
}

// ─── Step-by-Step Action Audit & Decision Telemetry ──────────────────────────
model ActionAuditLog {
  id             String       @id @default(uuid())
  companyId      String
  callSessionId  String
  callSession    CallSession  @relation(fields: [callSessionId], references: [id], onDelete: Cascade)
  
  turnIndex      Int
  customerSpeech String       @db.Text
  detectedIntent String?
  confidence     Float?
  
  toolName       String?
  toolArguments  Json?
  toolResult     Json?
  
  policyCheck    String       // "PASSED" | "BLOCKED" | "OVERRIDDEN"
  policyReason   String?
  agentUtterance String       @db.Text
  
  latencyMs      Int          @default(0)
  createdAt      DateTime     @default(now())

  @@index([companyId, callSessionId])
}

// ─── Universal Enterprise Business Brain & RAG ──────────────────────────────
model KnowledgeChunk {
  id              String              @id @default(uuid())
  companyId       String
  documentId      String
  documentTitle   String?
  
  vaultId         String?
  category        String?             @default("General")
  
  chunkIndex      Int
  content         String              @db.Text
  embedding       Json?               // 1536-dimensional float vector stored as JSON array
  metadata        Json?               @default("{}")
  
  createdAt       DateTime            @default(now())

  @@index([companyId])
  @@index([documentId])
  @@index([vaultId])
}

// ─── Central Dynamic Document Categories (Zero Hardcoding) ──────────────────
model DocumentCategory {
  id          String    @id @default(uuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  name        String    // e.g. "HR", "Legal", "Contracts", "Hardware Specs", "Pricing"
  color       String?   @default("#6366f1")
  description String?
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

// ─── Universal & Scoped RAG Memory Vaults ────────────────────────────────────
model RagMemoryVault {
  id                 String                @id @default(uuid())
  companyId          String
  company            Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  name               String                // e.g. "Customer Support Vault", "Sales & Catalogs"
  purposeDescription String?               @db.Text // Context anchor for semantic vector search
  mode               String                @default("general") // "general" | "business_driven"
  category           String?               @default("General")
  visibility         String                @default("public_voice") // "public_voice" | "internal_orbit" | "restricted_admin"
  
  // Business-Driven Structured Fields
  offeringsData      Json?                 @default("[]") // Catalog items with price & availability
  customerData       Json?                 @default("[]") // VIP client directory & phone numbers
  
  // Telemetry & Indexing Status
  totalDocuments     Int                   @default(0)
  totalChunks        Int                   @default(0)
  totalSizeBytes     BigInt                @default(0)
  status             String                @default("ready") // "ready" | "processing" | "error"
  progressPercent    Int                   @default(100)
  
  documents          VaultDocumentItem[]
  linkedAgents       VoiceAgentVaultLink[]
  
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([companyId])
  @@index([companyId, mode])
}

// ─── Pivot: Document to Vault ────────────────────────────────────────────────
model VaultDocumentItem {
  id              String         @id @default(uuid())
  vaultId         String
  vault           RagMemoryVault @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  
  documentId      String
  document        Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  
  status          String         @default("ready")
  chunksCount     Int            @default(0)
  
  createdAt       DateTime       @default(now())

  @@unique([vaultId, documentId])
  @@index([vaultId])
  @@index([documentId])
}

// ─── Pivot: Voice Agent to Vault Link ────────────────────────────────────────
model VoiceAgentVaultLink {
  id              String         @id @default(uuid())
  voiceAgentId    String
  voiceAgent      VoiceAgent     @relation(fields: [voiceAgentId], references: [id], onDelete: Cascade)
  
  vaultId         String
  vault           RagMemoryVault @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime       @default(now())

  @@unique([voiceAgentId, vaultId])
  @@index([voiceAgentId])
  @@index([vaultId])
}

// ─── Agent Request Queue (Voiceforce to Orbit AI Delegation) ───────────────────
model AgentRequest {
  id                  String         @id @default(uuid())
  companyId           String
  company             Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  voiceAgentId        String?
  voiceAgent          VoiceAgent?    @relation(fields: [voiceAgentId], references: [id], onDelete: SetNull)
  voiceAgentName      String?
  callSessionId       String?

  type                String         @default("schedule_meeting") // "schedule_meeting" | "customer_inquiry" | "order_booking" | "human_escalation"
  priority            String         @default("medium") // "urgent" | "high" | "medium" | "low"
  status              String         @default("pending") // "pending" | "auto_scheduled" | "confirmed" | "rejected" | "needs_review"

  customerName        String
  customerPhone       String?
  customerEmail       String?
  topic               String
  requestedTimeRaw    String?
  scheduledStart      DateTime?
  scheduledEnd        DateTime?
  locationOrPlatform  String?        @default("google_meet") // "google_meet" | "zoom" | "phone" | "in_person"
  notes               String?

  calendarEventId     String?
  calendarEvent       CalendarEvent? @relation(fields: [calendarEventId], references: [id], onDelete: SetNull)

  resolvedById        String?
  resolvedBy          User?          @relation("ResolvedAgentRequests", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt          DateTime?
  resolutionNotes     String?

  metadata            Json?          @default("{}")

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, type])
  @@index([voiceAgentId])
  @@index([calendarEventId])
  @@index([resolvedById])
  @@index([createdAt])
}

// ─── 180 MEDIA STUDIO (AUTONOMOUS VIDEO PRODUCTION ENGINE) ───────────────────

model VideoStudioProject {
