model CompanyAICreditAccount {
  id                    String   @id @default(uuid())
  companyId             String   @unique
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  // Credit Balances
  monthlyIncludedQuota  Int      @default(2000)
  monthlyCreditsUsed    Int      @default(0)
  purchasedCredits      Int      @default(0)
  reservedCredits       Int      @default(0)
  
  // Ledger Lifecycle
  billingCycleStart     DateTime @default(now())
  billingCycleEnd       DateTime @default(now())
  autoRechargeEnabled   Boolean  @default(false)
  autoRechargeThreshold Int      @default(500)
  autoRechargeAmountUsd Decimal  @default(5.00) @db.Decimal(10, 2)
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  ledgerEntries         AICreditLedgerEntry[]

  @@index([companyId])
}

model AICreditLedgerEntry {
  id                String   @id @default(uuid())
  accountId         String
  account           CompanyAICreditAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  companyId         String
  
  // Operation Metadata
  appId             String
  featureKey        String
  operationType     String
  
  // Quantities & Accounting
  creditsAmount     Int
  balanceAfter      Int
  rawUnitsCount     Int?
  unitType          String?
  costUsdEquivalent Decimal? @db.Decimal(10, 5)
  
  // Context & Correlation
  referenceId       String?
  userId            String?
  metadata          Json?    @default("{}")
  
  createdAt         DateTime @default(now())

  @@index([companyId, appId])
  @@index([createdAt])
}


model SavedBank {
  id        String   @id @default(uuid())
  companyId String
  type      String
  name      String
  content   String
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model CompanyCoreValue {
  id          String   @id @default(uuid())
  companyId   String
  title       String
  description String
  iconUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, id])
  @@index([companyId, createdAt])
}

model CompanyPublicReview {
  id            String   @id @default(uuid())
  companyId     String
  userId        String?
  reviewerName  String?
  reviewerEmail String?
  isVerified    Boolean  @default(false)
  rating        Float
  title         String
  description   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  company       Company  @relation("CompanyPublicReviews", fields: [companyId], references: [id], onDelete: Cascade)
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
  @@index([companyId, id])
  @@index([companyId, createdAt])
}

model CompanyFollower {
  id        String   @id @default(uuid())
  companyId String
  userId    String
  createdAt DateTime @default(now())
  company   Company  @relation("CompanyFollowers", fields: [companyId], references: [id], onDelete: Cascade)
  user      User     @relation("UserFollowingCompanies", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([userId])
  @@index([companyId, id])
  @@index([companyId, createdAt])
}

model CompanyConfig {
  id                   String    @id @default(uuid())
  companyId            String    @unique
  company              Company   @relation(fields: [companyId], references: [id])
  invoices             Invoice[]
  companyPaymentConfig Json?     @default("{}")
  storageUsedBytes     Float     @default(0)
  onboardingCompleted  Boolean   @default(false)
  timezone             String    @default("Asia/Kolkata")
  dateFormat           String    @default("DD/MM/YYYY")
  timeFormat           String    @default("12h")
  createdAt            DateTime  @default(now())

  @@index([companyId])
  @@index([companyId, id])
}

model Client {
  id        String  @id @default(uuid())
  name      String
  companyId String?

  email           String?
  phone           String?
  website         String?
  industry        String?
  taxId           String?
  billingAddress  String?
  location        String?
  status          String?
  notes           String?
  clientId        String?
  companyName     String?
  title           String?
  lastContacted   DateTime?
  employeeCount   String?
  annualRevenue   Float?    @default(0)
  clv             Float?    @default(0)
  healthStatus    String?   @default("Healthy")
  assignedManager String?
  country         String?
  leadSource      String?
  clientTier      String?
  category        String?

  // Recommended CRM Fields added for 180workspace
  shippingAddress   String?
  contactPersonName String?
  socialMediaLinks  Json?
  paymentTerms      String?
  currency          String?

  calendarEvents    CalendarEvent[] @relation("CalendarEventClients")

  automationLogs_AutomationTargetClient   AutomationLog[]       @relation("AutomationTargetClient")
  company                                 Company?              @relation("CompanyClients", fields: [companyId], references: [id])
  ClientCommunication                     ClientCommunication[]
  contentCalendars_ClientContentCalendars ContentCalendar[]     @relation("ClientContentCalendars")
  expenseTransactions                     ExpenseTransaction[]
  invoices                                Invoice[]
  CompanyTransaction                      CompanyTransaction[]  @relation("TransactionClient")
  deals                                   Deal[]                @relation("ClientDeals")
  salesActivities                         SalesActivity[]       @relation("ActivityClient")
  tasks                                   Task[]
  documents                               Document[]            @relation("ClientDocuments")
  socialAccounts                          SocialAccount[]       @relation("ClientSocialAccounts")
  socialPosts                             SocialPost[]          @relation("ClientSocialPosts")
  clientReviewSessions                    ClientReviewSession[] @relation("ClientReviewSessions")

  @@index([companyId])
  @@index([companyId, id])
}

model ClientCategory {
  id        String   @id @default(cuid())
  name      String
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  companyId   String?
  company     Company? @relation("CompanyClientCategories", fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
}

model Designation {
  id         String   @id @default(uuid())
  name       String
  category   String   @default("general")
  isCustom   Boolean  @default(false)
  usageCount Int      @default(0)
  createdAt  DateTime @default(now())
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id])
  users      User[]   @relation("UserDesignation")

  @@unique([companyId, name])
  @@index([companyId])
  @@index([companyId, id])
  @@index([companyId, createdAt])
}

