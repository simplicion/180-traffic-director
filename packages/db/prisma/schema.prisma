  documentCategories       DocumentCategory[]
  agentRequests            AgentRequest[]
  clientCategories_CompanyClientCategories ClientCategory[] @relation("CompanyClientCategories")
  chats_CompanyChats                       Chat[]           @relation("CompanyChats")
  messages_CompanyMessages                 Message[]        @relation("CompanyMessages")
  milestones_CompanyMilestones             Milestone[]      @relation("CompanyMilestones")
  notes_CompanyNotes                       Note[]           @relation("CompanyNotes")
  documentPages_CompanyDocumentPages       DocumentPage[]   @relation("CompanyDocumentPages")
  modules_CompanyModules                   Module[]         @relation("CompanyModules")
  onboardings_CompanyOnboardings           Onboarding[]     @relation("CompanyOnboardings")
  timeLogs_CompanyTimeLogs                 TimeLog[]        @relation("CompanyTimeLogs")
  applications_CompanyApplications         Application[]    @relation("CompanyApplications")
  leads_CompanyLeads                       Lead[]           @relation("CompanyLeads")
  deals_CompanyDeals                       Deal[]           @relation("CompanyDeals")
  salesActivities_CompanySalesActivities   SalesActivity[]  @relation("CompanySalesActivities")
  salesTasks_CompanySalesTasks             SalesTask[]      @relation("CompanySalesTasks")
  salesForecasts_CompanySalesForecasts     SalesForecast[]  @relation("CompanySalesForecasts")
  aiChatSessions_CompanyAiChatSessions     AiChatSession[]  @relation("CompanyAiChatSessions")
  aiChatMessages_CompanyAiChatMessages     AiChatMessage[]  @relation("CompanyAiChatMessages")
  calendarContentPieces_CompanyCalendarContentPieces CalendarContentPiece[] @relation("CompanyCalendarContentPieces")
  calendarTemplates_CompanyCalendarTemplates         CalendarTemplate[]     @relation("CompanyCalendarTemplates")
  callTranscriptSegments_CompanyCallTranscriptSegments CallTranscriptSegment[] @relation("CompanyCallTranscriptSegments")
  callToolExecutions_CompanyCallToolExecutions         CallToolExecution[]     @relation("CompanyCallToolExecutions")
  trafficRules_CompanyTrafficRules         TrafficRule[]    @relation("CompanyTrafficRules")
  trafficLogs_CompanyTrafficLogs           TrafficLog[]     @relation("CompanyTrafficLogs")
  trafficPixelConfigs_CompanyTrafficPixelConfigs TrafficPixelConfig[] @relation("CompanyTrafficPixelConfigs")
  trafficPixelLogs_CompanyTrafficPixelLogs       TrafficPixelLog[]    @relation("CompanyTrafficPixelLogs")
  pixels_CompanyPixels                     Pixel[]          @relation("CompanyPixels")
  websiteFormSubmissions_CompanyWebsiteFormSubmissions WebsiteFormSubmission[] @relation("CompanyWebsiteFormSubmissions")

  socialAccounts_CompanySocialAccounts SocialAccount[] @relation("CompanySocialAccounts")
  brandVoiceProfiles_CompanyBrandVoiceProfiles BrandVoiceProfile[] @relation("CompanyBrandVoiceProfiles")
  socialPosts_CompanySocialPosts SocialPost[] @relation("CompanySocialPosts")
  clientReviewSessions_CompanyClientReviewSessions ClientReviewSession[] @relation("CompanyClientReviewSessions")
  socialConversations_CompanySocialConversations SocialConversation[] @relation("CompanySocialConversations")
  evergreenQueueSlots_CompanyEvergreenQueueSlots EvergreenQueueSlot[] @relation("CompanyEvergreenQueueSlots")
  socialEngagementRules_CompanySocialEngagementRules SocialEngagementRule[] @relation("CompanySocialEngagementRules")
  managerConversations_CompanyManagerConversations ManagerConversation[] @relation("CompanyManagerConversations")
  postVideoIntelligences_CompanyPostVideoIntelligences PostVideoIntelligence[] @relation("CompanyPostVideoIntelligences")
