  bannerUrl                                String?
  oneLineDescription                       String?
  industry                                 String?
  startupStage                             String?
  teamSize                                 String?
  country                                  String?
  website                                  String?
  customDomain                             String?               @unique
  foundedDate                              DateTime?
  companyType                              String?
  tagline                                  String?
  headquarters                             String?
  otherOffices                             String?
  aboutUs                                  String?
  vision                                   String?
  mission                                  String?
  story                                    String?
  coreValues                               Json?                 @default("[]")
  socialLinks                              Json?                 @default("{}")
  productsBuilt                            String?
  happyClients                             String?
  countriesActive                          String?
  awardsCount                              String?
  topRecognition                           String?
  companyHighlights                        Json?                 @default("[]")
  profileViews                             Int                   @default(0)
  followersCount                           Int                   @default(0)
  privacySettings                          Json?                 @default("{}")
  adminName                                String?
  adminEmail                               String?               @unique
  adminPhone                               String?
  adminPasswordHash                        String?
  adminRole                                String                @default("admin")
  databaseConfigured                       Boolean               @default(false)
  isOnboardingComplete                     Boolean               @default(false)
  subscriptionStatus                       String                @default("trial")
  accountStatus                            String                @default("active")
  totalUsers                               Int                   @default(0)
  currency                                 String?               @default("USD")
  currencySymbol                           String?               @default("$")
  metadata                                 Json?                 @default("{}")
  trialStartDate                           DateTime?
  trialEndDate                             DateTime?
  nextChargeDate                           DateTime?
  autopayEnabled                           Boolean               @default(false)
  mandateStatus                            String?
  createdAt                                DateTime              @default(now())
  updatedAt                                DateTime              @updatedAt
  attendances                              Attendance[]
  auditLogs                                AuditLog[]
  automationLogs_CompanyAutomationLogs     AutomationLog[]       @relation("CompanyAutomationLogs")
  clients_CompanyClients                   Client[]              @relation("CompanyClients")
  CompanyConfig                            CompanyConfig?
  coreValueItems                           CompanyCoreValue[]
  followersList                            CompanyFollower[]     @relation("CompanyFollowers")
  investors                                CompanyInvestor[]
  media                                    CompanyMedia[]
  publicReviews                            CompanyPublicReview[] @relation("CompanyPublicReviews")
  offerings                                CompanyOffering[]
  contentCalendars_CompanyContentCalendars ContentCalendar[]     @relation("CompanyContentCalendars")
  designations                             Designation[]
  documents_CompanyDocuments               Document[]            @relation("CompanyDocuments")
  emailLogs_CompanyEmailLogs               EmailLog[]            @relation("CompanyEmailLogs")
  events_CompanyEvents                     Event[]               @relation("CompanyEvents")
  expenseTransactions                      ExpenseTransaction[]
  goals                                    Goal[]
  holidays_CompanyHolidays                 Holiday[]             @relation("CompanyHolidays")
  jobs_CompanyJobs                         Job[]                 @relation("CompanyJobs")

