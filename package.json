{
  "name": "traffic-director",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:backend": "pnpm --filter traffic-director-backend dev",
    "dev:frontend": "pnpm --filter traffic-director-web dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "prettier": "latest",
    "turbo": "latest",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": "9"
  },
  "prisma": {
    "schema": "packages/db/prisma/schema.prisma"
  }
}
