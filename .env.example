PORT=4005
TD_PORT=4005
TRAFFIC_DIRECTOR_PORT=4005
JWT_SECRET=your_jwt_secret_here
DATABASE_URL=postgresql://user:password@hostname:5432/traffic_director_db
TRAFFIC_DIRECTOR_WEB_URL=https://180trafficdirector.pro
PUBLIC_EDGE_URL=https://api.180trafficdirector.pro
NEXT_PUBLIC_API_URL=https://api.180trafficdirector.pro
DEFAULT_EDGE_DOMAIN=lokaya.shop
AVAILABLE_EDGE_DOMAINS=lokaya.shop,180trafficdirector.pro
CORE_BACKEND_URL=https://api.180core.cloud
AUTH_SERVER_URL=https://profile.180core.cloud

TRAFFIC_DIRECTOR_CLIENT_ID="your_180_client_id_here"
TRAFFIC_DIRECTOR_CLIENT_SECRET="your_180_client_secret_here"
TRAFFIC_DIRECTOR_WEBHOOK_SECRET="your_180_webhook_secret_here"

# Optional: separate key for encrypting stored CAPI tokens (falls back to JWT_SECRET)
TRAFFIC_DIRECTOR_SECRET_KEY=
REDIS_URL=
# Extra OAuth origins registered by the setup scripts (comma separated)
OAUTH_ALLOWED_ORIGINS=
TRAFFIC_DIRECTOR_PROJECT_ID=
# Connection string for the 180 Core database (only used by maintenance scripts)
CORE_DATABASE_URL=
# Custom-domain onboarding
ROOT_DOMAIN=
CUSTOM_DOMAIN_CNAME_TARGET=

# Local development only: enables POST /oauth/dev-token (ignored when NODE_ENV=production)
ENABLE_DEV_LOGIN=false
DEV_LOGIN_EMAIL=

# nginx sync script (scripts/sync-nginx-traffic-director.py)
NGINX_EXTRA_SERVER_NAMES=
NGINX_CONF_PATH=
NGINX_PROXY_CONTAINER=
