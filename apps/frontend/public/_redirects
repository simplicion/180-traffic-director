# Cloudflare Pages Reverse Proxy - API routes to Express backend
/api/v1/traffic-director/*  https://api.180trafficdirector.pro/api/v1/traffic-director/:splat  200
/oauth/*                    https://api.180trafficdirector.pro/oauth/:splat                    200
/r/*                        https://api.180trafficdirector.pro/r/:splat                        200
/tag/*                      https://api.180trafficdirector.pro/tag/:splat                      200
/evaluate/*                 https://api.180trafficdirector.pro/evaluate/:splat                  200
/pixel/*                    https://api.180trafficdirector.pro/pixel/:splat                     200
/health                     https://api.180trafficdirector.pro/health                           200

# SPA Rewrites for Traffic Director dynamic routes
/traffic-director/links/*.txt    /traffic-director/links/default.txt   200
/traffic-director/links/*        /traffic-director/links/default       200
