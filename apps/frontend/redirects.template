# SPA Rewrites for Traffic Director dynamic routes (same-origin only)
# Note: External backend reverse-proxying (/r/*, /tag/*, /evaluate/*, /pixel/*,
# /shield/*, /api/v1/traffic-director/*, /oauth/*, /health) is handled by
# out/_worker.js + out/_routes.json because Cloudflare Pages _redirects does not
# support 200 reverse-proxy rules to external origins.
/traffic-director/links/*.txt    /traffic-director/links/default.txt   200
/traffic-director/links/*        /traffic-director/links/default       200
/forms/*.txt                     /forms/default.txt                    200
/forms/*                         /forms/default                        200
/advertising/*/edit.txt          /advertising/default/edit.txt         200
/advertising/*/edit              /advertising/default/edit             200
/advertising/*.txt               /advertising/default.txt              200
/advertising/*                   /advertising/default                  200
/f/*.txt                         /f/default.txt                        200
/f/*                             /f/default                            200
/sites/*.txt                     /sites/default.txt                    200
/sites/*                         /sites/default                        200
